# Crema - AI Study Buddy Environment Variables

# Gemini AI API Configuration (SERVER-SIDE ONLY - Never exposed to client)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL_FAST="gemini-2.5-flash"
GEMINI_MODEL_DEEP="gemini-2.5-pro"

# Server Configuration
PORT=3000
NODE_ENV="development"
GUEST_JWT_SECRET="crema-super-secret-guest-jwt-signing-key-32chars"

# Google Integrations (Optional)
# Published CSV link from Google Forms / Sheets responses:
GOOGLE_FORMS_EXAMS_CSV_URL=""
# Google Drive & OAuth Picker (Optional):
VITE_GOOGLE_DRIVE_API_KEY=""
VITE_GOOGLE_CLIENT_ID=""
